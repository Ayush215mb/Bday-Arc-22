{
    "name": "@trip-planner/agent",
    "version": "0.1.0",
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/agent.ts",
            "default": "./dist/agent.js"
        },
        "./graph": {
            "types": "./src/graph/index.ts",
            "default": "./dist/graph/index.js"
        },
        "./schemas": {
            "types": "./src/schemas/index.ts",
            "default": "./dist/schemas/index.js"
        },
        "./models": {
            "types": "./src/models/index.ts",
            "default": "./dist/models/index.js"
        }
    },
    "scripts": {
        "dev": "npx @langchain/langgraph-cli dev",
        "start": "tsx src/index.ts",
        "build": "tsup src/agent.ts src/graph/index.ts src/schemas/index.ts src/models/index.ts --format esm --out-dir dist --clean",
        "start:graph": "tsx src/graph.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@langchain/core": "^1.3.0",
        "@langchain/deepseek": "^1.1.21",
        "@langchain/langgraph": "^1.5.3",
        "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
        "@langchain/ollama": "^1.3.0",
        "@langchain/openai": "^1.8.0",
        "@langchain/tavily": "^1.2.0",
        "dotenv": "^18.0.9",
        "langchain": "^1.5.20",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "tsup": "^8.5.0",
        "@langchain/langgraph-cli": "^1.7.0"
    }
}
